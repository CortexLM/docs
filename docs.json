{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cortex CLI Documentation",
  "colors": {
    "primary": "#22C55E",
    "light": "#4ADE80",
    "dark": "#16A34A"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "CLI Reference",
            "pages": [
              "cli/overview",
              "cli/run",
              "cli/exec",
              "cli/sessions",
              "cli/agents",
              "cli/mcp",
              "cli/auth",
              "cli/models",
              "cli/stats",
              "cli/github",
              "cli/serve",
              "cli/upgrade"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/settings"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/agents",
              "guides/commands"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint Examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/cortexlm/cortex-cli",
          "icon": "github"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.gg/cortex",
          "icon": "discord"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://github.com/cortexlm/cortex-cli/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/cortexlm",
      "github": "https://github.com/cortexlm",
      "discord": "https://discord.gg/cortex"
    }
  },
  "seo": {
    "indexHiddenPages": false
  },
  "analytics": {
    "ga4": {
      "measurementId": ""
    }
  }
}
