{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Cortex Docs",
  "theme": "willow",
  "description": "Product docs for Cortex Chat, Code, Bot, Design, and the Cortex CLI. Platform API lives elsewhere.",
  "colors": {
    "primary": "#1F4945",
    "light": "#8AC5B9",
    "dark": "#163834"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FAF8F4",
      "dark": "#211F1C"
    }
  },
  "favicon": "/logo/light.svg",
  "logo": {
    "light": "/logo/banner-light.png",
    "dark": "/logo/banner-dark.png",
    "href": "https://docs.cortex.foundation"
  },
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "/"
      },
      {
        "label": "Documentation",
        "href": "/getting-started/quickstart"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://cortex.foundation"
    },
    "links": [
      {
        "header": "Products",
        "items": [
          {
            "label": "Chat",
            "href": "/chat"
          },
          {
            "label": "Code",
            "href": "/code"
          },
          {
            "label": "Bot",
            "href": "/bot"
          },
          {
            "label": "CLI",
            "href": "/cli"
          },
          {
            "label": "Design",
            "href": "/design"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "Get started",
            "href": "/getting-started/quickstart"
          },
          {
            "label": "Downloads",
            "href": "/getting-started/downloads"
          },
          {
            "label": "Troubleshooting",
            "href": "/getting-started/troubleshooting"
          },
          {
            "label": "Changelog",
            "href": "/changelog"
          },
          {
            "label": "System status",
            "href": "/status"
          }
        ]
      },
      {
        "header": "Cortex",
        "items": [
          {
            "label": "Website",
            "href": "https://cortex.foundation"
          },
          {
            "label": "Status",
            "href": "https://status.cortex.foundation"
          },
          {
            "label": "Privacy",
            "href": "https://cortex.foundation/privacy"
          },
          {
            "label": "Terms",
            "href": "https://cortex.foundation/terms"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search docs..."
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "That path is not in Cortex Docs. Try [Get started](/getting-started/quickstart), [Chat](/chat), [Code](/code), [Bot](/bot), [CLI](/cli), or [Design](/design). If a product message sent you here, the [problem catalog](/problems) explains it. The inference Platform API is not documented here."
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Cortex Docs",
      "og:image": "/images/banners/getting-started.png"
    },
    "organization": {
      "name": "Cortex",
      "url": "https://cortex.foundation"
    }
  },
  "redirects": [
    {
      "source": "/chat/overview",
      "destination": "/chat"
    },
    {
      "source": "/code/overview",
      "destination": "/code"
    },
    {
      "source": "/bot/overview",
      "destination": "/bot"
    },
    {
      "source": "/design/overview",
      "destination": "/design"
    },
    {
      "source": "/chat/conversations",
      "destination": "/chat/projects"
    },
    {
      "source": "/chat/plugins",
      "destination": "/chat/tools"
    },
    {
      "source": "/chat/artifacts",
      "destination": "/chat/library"
    },
    {
      "source": "/getting-started/cli",
      "destination": "/cli/install"
    },
    {
      "source": "/getting-started/desktop-app",
      "destination": "/getting-started/desktop"
    },
    {
      "source": "/code/goals",
      "destination": "/cli/goal"
    },
    {
      "source": "/troubleshooting",
      "destination": "/getting-started/troubleshooting"
    },
    {
      "source": "/api/authentication",
      "destination": "/getting-started/accounts"
    },
    {
      "source": "/api/oauth",
      "destination": "/getting-started/accounts"
    },
    {
      "source": "/api/chat",
      "destination": "/chat"
    },
    {
      "source": "/api/code",
      "destination": "/code"
    },
    {
      "source": "/api/bot",
      "destination": "/bot"
    },
    {
      "source": "/api/design",
      "destination": "/design"
    },
    {
      "source": "/api/plugins",
      "destination": "/chat/tools"
    },
    {
      "source": "/api/streaming",
      "destination": "/chat/streaming"
    },
    {
      "source": "/api/webhooks",
      "destination": "/code/security"
    }
  ],
